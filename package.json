{
  "name": "@npm-ken/pi-browser",
  "version": "0.1.1",
  "type": "module",
  "description": "Persistent browser tools for pi using a Python-bundled Playwright driver.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenbanks-peng/pi-browser.git"
  },
  "homepage": "https://github.com/kenbanks-peng/pi-browser#readme",
  "bugs": {
    "url": "https://github.com/kenbanks-peng/pi-browser/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "browser"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.ts",
    "runtime/browser.mjs",
    "runtime/options.py",
    "runtime/README.md",
    "runtime/workflow.mjs",
    "runtime/workflow-run.mjs",
    "runtime/workflow-load.mjs",
    "WORKFLOWS.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm run test:fast",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check:runtime": "node runtime/browser.mjs",
    "typecheck": "tsc --noEmit",
    "test:fast": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:integration": "PI_BROWSER_TEST_INTEGRATION=1 node --test --test-concurrency=1 test/*.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "playwright-core": "1.60.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
