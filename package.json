{
  "name": "@npm-ken/pi-camoufox",
  "version": "0.1.1",
  "type": "module",
  "description": "Persistent Camoufox browser tools for pi using an explicitly configured Python-bundled Playwright driver.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenbanks-peng/pi-camoufox.git"
  },
  "homepage": "https://github.com/kenbanks-peng/pi-camoufox#readme",
  "bugs": {
    "url": "https://github.com/kenbanks-peng/pi-camoufox/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "camoufox",
    "browser"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "index.ts",
    "runtime/camoufox.mjs",
    "runtime/options.py",
    "runtime/README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm run test:fast",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check:runtime": "node runtime/camoufox.mjs",
    "typecheck": "tsc --noEmit",
    "test:fast": "env -u PI_CAMOUFOX_EXECUTABLE -u PI_CAMOUFOX_PYTHON node --test --test-concurrency=1 test/*.test.mjs",
    "test:integration": "node -e \"if (!process.env.PI_CAMOUFOX_EXECUTABLE || !process.env.PI_CAMOUFOX_PYTHON) process.exit(1)\" && node --test --test-concurrency=1 test/*.test.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "playwright-core": "1.60.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
